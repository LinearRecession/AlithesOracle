# Required for live Jev API calls
TYPESAFE_API_KEY=

# Pinned TypeSafe Jev model (aliases jev-latest/jev-preview are rejected by default)
JEV_MODEL=jev-1.14.0

# Background polling scheduler for ACTIVE questions (true/false)
ORACLE_SCHEDULER_ENABLED=true

# HMAC-SHA256 signing secret for outgoing webhooks
WEBHOOK_SECRET=dev-secret-change-me

# PostgreSQL credentials used by docker-compose.yml
DATABASE_USER=alithes
DATABASE_PASSWORD=alithes
